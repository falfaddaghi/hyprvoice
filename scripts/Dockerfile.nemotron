FROM nvcr.io/nvidia/nemo:24.12

RUN pip install --no-cache-dir flask numpy

COPY nemotron_server.py /app/nemotron_server.py

EXPOSE 8080

# Model is downloaded on first run and cached via mounted volume.
# Run with: docker run --rm --gpus all -p 8080:8080 -v nemotron-cache:/root/.cache nemotron-asr
CMD ["python3", "/app/nemotron_server.py", "--port", "8080"]
